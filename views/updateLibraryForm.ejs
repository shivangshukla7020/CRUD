<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/card.css">
    <link rel="stylesheet" href="/navbar.css">
</head>
<body>
    <div class="navbar">
        <a href="/">Home</a>
        <div>
            <button><a href="/Library/add">Add Order</a></button>
            <button><a href="/Library/all">Show Order</a></button>
        </div>
    </div>
    <!-- <h1>Update Library</h1> -->

    <div class = 'card'>
        <form action="/Library/update/<%= library.id%>?_method=PUT" method="POST">
    

            <label for="">Oder Name</label>
            <input type="text" placeholder="Library Name" name="libraryName" value="<%= library.libraryName %>"/><br>

            <label for="">Genre</label>
            <input type="text" placeholder="location" name="location" value="<%= library.location %>"/><br>

            <label for="noOfBooks"></label>
            <input type="number" placeholder="Number of books" name="noOfBooks" value="<%= library.noOfBooks %>"/><br>

            <label for="establishedYear"></label>
            <input type="number" placeholder="Established Year" name="establishedYear" value="<%= library.establishedYear %>"/><br>

            <label for="">hasDigitalSection</label>
            <input type="text" checked name="hasDigitalSection" value="<%= library.hasDigitalSection %>"/> <br>

            <label for="">openingHours</label>
            <input type="text" placeholder="Opening Hours" name="openingHours" value="<%= library.openingHours %>"/><br>

            <label for="">contactEmail</label>
            <input type="email" placeholder="Contact Email" name="contactEmail" value="<%= library.contactEmail %>"/><br>
            
            <button type="submit">Update</button>
        </form>
    </div>
</body>
</html>